{
  // Master switch. auto = the session-start conductor offers the installed doc
  // canaries at the right moment (domain entry, ask-gated); manual = conductor
  // silent, you invoke canaries yourself; off = fully silent.
  "coalledgerMode": "auto",

  // Language for prompts and nudges. auto = follow the conversation's language;
  // a locked value pins user-facing prose (technical terms stay verbatim).
  "language": "auto",

  // Canary names to disable, e.g. ["doc-structure"]. "conductor" or "all"
  // silences the conductor entirely.
  "disabledCanaries": [],

  // Report findings at or above this severity (low, medium, high, critical).
  // Severity is assigned by context in the report step, never mechanically.
  // Fully settable per project, same as quickVsFull below (the global-vs-
  // project consent clamp has no path to this key — every reader is the
  // agent, never a hook): a project setting a high floor is honoured as
  // written and can silently narrow what a run reports. Unlike quickVsFull's
  // spend, which is backstopped unconditionally at run-time regardless of
  // this file, a narrowed report is inspectable only ON REQUEST via
  // `/coalledger:stats` — not visible by default, and stats shows the
  // floor's value, never the count of findings it withheld.
  "severityFloor": "low",

  // Default scan tier for the mixed canaries: quick = mechanical layer only
  // (~free, report-only); full = adds the semantic layer (paid; always a
  // separate consent).
  // Fully settable per project: unlike coalledgerMode / updateMode /
  // disabledCanaries / docLeak, the global-vs-project consent clamp has no
  // path to this key — the agent reads it from this file directly, so a
  // project setting "full" is honoured as written. The per-run consent ask
  // is what gates the actual spend.
  "quickVsFull": "quick",

  // Enable the #7 doc-leak canary (prose-level public/private boundary).
  // Default on; a private-only project (docs never published) turns it off.
  "docLeak": true,

  // Treat this project's docs as PUBLIC-facing (raises leak/grounding stakes
  // in severity context).
  "publicMode": false,

  // Docs memory-drift advisory (the DOCS mirror of CoalMine's memoryDriftNudge,
  // which covers CODE). When the agent finishes responding, if documentation
  // files were edited but MEMORY.md has not been updated this session, one QUIET
  // model-context note is emitted — no report, no fix menu, never blocks. Once
  // you update MEMORY.md it stays quiet for the rest of the session. Default on;
  // set false to silence.
  "docsDriftNudge": true,

  // Self-update (series standard). The session-start hook only SCHEDULES a check
  // via a throttled local stamp (no network); the AGENT verifies the latest tag
  // and offers the update, consent-gated. ask = offer when due; auto = standing
  // consent to check + offer; remind = a free reminder, you run it; off = silent.
  "updateMode": "ask",

  // Days between self-update checks/reminders (1-365; out-of-range clamps to 14 on read).
  "updateCheckDays": 14
}
